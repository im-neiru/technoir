import {
  "im-neiru/rain/gen/world/ext-wallpaper" @ext-wallpaper,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportClose:close",
        "wasmExportDraw:draw",
        "wasmExportPrepare:prepare"
      ],
    },
  },
)
