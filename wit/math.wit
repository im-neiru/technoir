package technoir:plugin@0.1.0;

interface math {
    record vec2 { x: f32, y: f32 }
    record vec3 { x: f32, y: f32, z: f32 }
    record vec4 { x: f32, y: f32, z: f32, w: f32 }

    record uvec2 { x: u32, y: u32 }
    record uvec3 { x: u32, y: u32, z: u32 }
    record ivec2 { x: s32, y: s32 }
    record ivec3 { x: s32, y: s32, z: s32 }

    record quat { x: f32, y: f32, z: f32, w: f32 }

    record mat3 { x-axis: vec3, y-axis: vec3, z-axis: vec3 }
    record mat4 { x-axis: vec4, y-axis: vec4, z-axis: vec4, w-axis: vec4 }

    record aabb { minimum: vec3, maximum: vec3 }
}
