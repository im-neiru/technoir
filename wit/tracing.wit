package technoir:plugin@0.1.0;

interface tracing {
    enum level {
        error,
        warn,
        info,
        debug,
        trace,
    }

    variant value {
        text(string),
        boolean(bool),
        signed(s64),
        unsigned(u64),
        floating(f64),
    }

    record field {
        name: string,
        value: value,
    }

    type span-id = u64;

    enabled: func(
        level: level,
        target: option<string>,
    ) -> bool;

    event: func(
        level: level,
        target: option<string>,
        message: string,
        span: option<span-id>,
        fields: list<field>,
    );

    span-start: func(
        level: level,
        target: option<string>,
        name: string,
        parent: option<span-id>,
        fields: list<field>,
    ) -> option<span-id>;

    span-end: func(id: span-id);
}
